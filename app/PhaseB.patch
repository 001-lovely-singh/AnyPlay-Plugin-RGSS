@@ -0,0 +1,33 @@
+# ruby-legacy: Ruby 1.8 compatibility layer for the r18 runtime
+
+Applied **only** to the `ruby-r18` source tree (never to `ruby`, which is r3).
+`make ruby-r18` runs `apply-legacy-patches.py` first (stamp-file driven).
+
+| File | What it is |
+|---|---|
+| `mkxp_legacy.inc` | C, built into libruby via an `#include` appended to `vm_eval.c`. Flag API, legacy-code registry, `String#[]` byte numbers, `RUBY_VERSION` spoof. |
+| `legacy_prelude.rb` | Ruby shims, evaluated by `mkxp_legacy_set_enabled(1)`. |
+| `apply-legacy-patches.py` | Copies the two files above into the tree. Edits **no existing line** of Ruby's sources. |
+| `tests/check_c_syntax.sh` | Host check of the C part against a stub of the Ruby API. |
+| `tests/legacy_selftest.rb` | Game script that checks the shims on the real r18 VM. |
+
+## Exported API (libruby_r18.so)
+
+```
+int  mkxp_legacy_set_enabled(int on)            old value; first `on` installs the shims
+int  mkxp_legacy_enabled_p(void)
+void mkxp_legacy_prepare_next_eval(const char*) registers the file name as legacy code
+void mkxp_legacy_cancel_next_eval(void)         clears the pending flag (name stays registered)
+int  mkxp_legacy_caller_p(void)                 is the calling Ruby frame legacy code?
+```
+
+"Legacy code" is decided by **file name**: the engine registers `003:Name` / `Section003`
+before it evals each game script, and every method/block compiled from that file has the
+same path. Ruby's stdlib has other paths, so it keeps Ruby 3.1 behaviour.
+
+## Not done yet (needs the real Ruby tree to write and test against)
+
+Parser / VM changes: `when x:`, `?a` as Integer, `return` inside a top-level proc,
+1.8 block-variable scoping. They stay in the text normalizer
+(`binding/ruby187-source-normalizer.cpp`) for now. They need edits in `parse.y` /
+`vm_insnhelper.c` and a `bison` run to check for grammar conflicts.
diff -ruN '--exclude=.git' orig/proj/app/jni/ruby-legacy/apply-legacy-patches.py AnyPlay-Plugin-RGSS-main/AnyPlay-Plugin-RGSS-main/app/jni/ruby-legacy/apply-legacy-patches.py
--- a/app/jni/ruby-legacy/apply-legacy-patches.py	1970-01-01 00:00:00.000000000 +0000
+++ b/app/jni/ruby-legacy/apply-legacy-patches.py	2026-11-07 07:38:30.992301305 +0000
@@ -0,0 +1,82 @@
+#!/usr/bin/env python3
+"""Applies the AnyPlay Ruby 1.8 compatibility layer to a Ruby 3.1 source tree.
+
+    python3 apply-legacy-patches.py <ruby-r18 source dir>
+
+Only the r18 tree is ever patched; the clean r3 tree must stay untouched.
+
+What it does (all idempotent, safe to run on every build):
+  1. copies mkxp_legacy.inc into the tree
+  2. turns legacy_prelude.rb into mkxp_legacy_prelude.h (a C byte array)
+  3. appends  #include "mkxp_legacy.inc"  to vm_eval.c (once)
+  4. touches vm_eval.c when 1-3 changed anything, so `make` rebuilds it
+     (Ruby's dependency list does not know about the .inc file)
+
+It does not edit any existing line of Ruby's sources, so it cannot fail because an
+upstream line moved. Parser / VM changes are NOT in here yet (see README.md).
+"""
+import os
+import sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+MARK = '#include "mkxp_legacy.inc"'
+
+
+def read(path, mode="rb"):
+    with open(path, mode) as f:
+        return f.read()
+
+
+def write_if_changed(path, data):
+    old = read(path) if os.path.exists(path) else None
+    if old == data:
+        return False
+    with open(path, "wb") as f:
+        f.write(data)
+    return True
+
+
+def c_array(name, data):
+    lines = []
+    for i in range(0, len(data), 16):
+        lines.append("  " + ", ".join("0x%02x" % b for b in data[i:i + 16]) + ",")
+    body = "\n".join(lines)
+    return ("/* generated by apply-legacy-patches.py from legacy_prelude.rb */\n"
+            "static const char %s[] = {\n%s\n  0x00\n};\n" % (name, body)).encode()
+
+
+def main():
+    if len(sys.argv) != 2:
+        sys.exit(__doc__)
+    tree = os.path.abspath(sys.argv[1])
+    vm_eval = os.path.join(tree, "vm_eval.c")
+    if not os.path.isfile(vm_eval):
+        sys.exit("apply-legacy-patches: %s is not a Ruby source tree (no vm_eval.c)" % tree)
+    if os.path.basename(tree) == "ruby":
+        sys.exit("apply-legacy-patches: refusing to patch the clean r3 tree 'ruby'")
+
+    changed = False
+    changed |= write_if_changed(os.path.join(tree, "mkxp_legacy.inc"),
+                                read(os.path.join(HERE, "mkxp_legacy.inc")))
+    changed |= write_if_changed(os.path.join(tree, "mkxp_legacy_prelude.h"),
+                                c_array("mkxp_legacy_prelude_src",
+                                        read(os.path.join(HERE, "legacy_prelude.rb"))))
+
+    src = read(vm_eval, "r").replace("\r\n", "\n")
+    if MARK not in src:
+        if not src.endswith("\n"):
+            src += "\n"
+        src += "\n/* AnyPlay: Ruby 1.8 compatibility layer (apply-legacy-patches.py) */\n" + MARK + "\n"
+        with open(vm_eval, "w", newline="\n") as f:
+            f.write(src)
+        changed = True
+
+    if changed:
+        os.utime(vm_eval, None)
+        print("apply-legacy-patches: applied to %s" % tree)
+    else:
+        print("apply-legacy-patches: already up to date (%s)" % tree)
+
+
+if __name__ == "__main__":
+    main()
diff -ruN '--exclude=.git' orig/proj/app/jni/ruby-legacy/legacy_prelude.rb AnyPlay-Plugin-RGSS-main/AnyPlay-Plugin-RGSS-main/app/jni/ruby-legacy/legacy_prelude.rb
--- a/app/jni/ruby-legacy/legacy_prelude.rb	1970-01-01 00:00:00.000000000 +0000
+++ b/app/jni/ruby-legacy/legacy_prelude.rb	2026-11-07 07:37:52.288432133 +0000
@@ -0,0 +1,168 @@
+# AnyPlay legacy prelude: Ruby 1.8 behaviour on top of the r18 (Ruby 3.1) VM.
+#
+# Evaluated once, from mkxp_legacy_set_enabled(1), after Ruby is initialised and
+# before any game script runs. Every shim sits in its own guarded block: if one of
+# them fails the error is recorded in $__mkxp_legacy_errors and the rest still load.
+# Shims that need to tell "game code" from "Ruby's own library code" use the C
+# helper (String#[]); everything here is either harmless for library code or only
+# adds methods that Ruby 3 does not have.
+
+module MkxpLegacy
+  ERRORS = []
+  STATS  = {}
+
+  def self.guard(name)
+    yield
+  rescue Exception => e
+    ERRORS << "#{name}: #{e.class}: #{e.message}"
+    $__mkxp_legacy_errors = ERRORS.join("\n")
+  end
+
+  # One short line for AnyPlayLog.
+  def self.report
+    parts = []
+    parts << "shim_errors=#{ERRORS.size}" unless ERRORS.empty?
+    n = STATS[:id2ref_fail].to_i
+    parts << "id2ref_fail=#{n}" if n > 0
+    parts << "version=#{Object.const_defined?(:RUBY_VERSION_REAL) ? RUBY_VERSION_REAL : RUBY_VERSION}"
+    parts.join(" ")
+  end
+
+  def self.details
+    out = ERRORS.dup
+    (STATS[:id2ref_where] || []).each do |msg, where|
+      out << "id2ref: #{msg} from #{where.first(3).join(' < ')}"
+    end
+    out
+  end
+end
+
+# ---- methods Ruby 1.8 had and Ruby 3 removed --------------------------------
+
+MkxpLegacy.guard("Thread.critical") do
+  class Thread
+    class << self
+      unless respond_to?(:critical)
+        def critical; false; end
+        def critical=(v); v; end
+      end
+    end
+  end
+end
+
+MkxpLegacy.guard("Object#type") do
+  class Object
+    def type; self.class; end unless method_defined?(:type)
+  end
+end
+
+MkxpLegacy.guard("Array#nitems") do
+  class Array
+    def nitems; count { |x| !x.nil? }; end unless method_defined?(:nitems)
+  end
+end
+
+MkxpLegacy.guard("String#each") do
+  class String
+    unless method_defined?(:each)
+      def each(*args, &block)
+        return to_enum(:each, *args) unless block
+        each_line(*args, &block)
+        self
+      end
+    end
+  end
+end
+
+MkxpLegacy.guard("Hash#index") do
+  class Hash
+    def index(value); key(value); end
+  end
+end
+
+MkxpLegacy.guard("Fixnum/Bignum") do
+  v = $VERBOSE
+  $VERBOSE = nil
+  begin
+    Object.const_set(:Fixnum, Integer) unless Object.const_defined?(:Fixnum)
+    Object.const_set(:Bignum, Integer) unless Object.const_defined?(:Bignum)
+  ensure
+    $VERBOSE = v
+  end
+end
+
+MkxpLegacy.guard("File.exists?") do
+  class << File
+    alias_method :exists?, :exist? unless respond_to?(:exists?)
+  end
+  class << Dir
+    alias_method :exists?, :exist? unless respond_to?(:exists?)
+  end
+end
+
+# ---- ObjectSpace._id2ref ----------------------------------------------------
+# Ruby 1.8 scripts (Essentials' WeakRef / bitmap cache) call _id2ref and treat
+# RangeError as "object is gone". Ruby 3.1 raises the same error, but its GC frees
+# unreferenced objects much sooner than 1.8 did. Count the failures and keep the
+# first callers so AnyPlayLog shows who is hitting it and how often.
+MkxpLegacy.guard("ObjectSpace._id2ref") do
+  if ObjectSpace.respond_to?(:_id2ref)
+    class << ObjectSpace
+      alias_method :__mkxp_legacy_id2ref, :_id2ref
+      def _id2ref(id)
+        __mkxp_legacy_id2ref(id)
+      rescue RangeError => e
+        st = MkxpLegacy::STATS
+        st[:id2ref_fail] = st[:id2ref_fail].to_i + 1
+        if st[:id2ref_fail] <= 3
+          (st[:id2ref_where] ||= []) << [e.message.to_s[0, 80], (caller(1, 4) || [])]
+        end
+        raise
+      end
+    end
+  end
+end
+
+# ---- RUBY_VERSION is 1.8.7 for game code, the real one for libraries ---------
+# Ruby's own library files check RUBY_VERSION when they are loaded. Give them the
+# real values while a `require` is running, and put the spoofed ones back after.
+MkxpLegacy.guard("require/RUBY_VERSION") do
+  names = [:RUBY_VERSION, :RUBY_PATCHLEVEL, :RUBY_RELEASE_DATE, :RUBY_COPYRIGHT, :RUBY_DESCRIPTION]
+  if names.all? { |n| Object.const_defined?(n) && Object.const_defined?("#{n}_REAL") }
+    MkxpLegacy.const_set(:NAMES, names)
+    MkxpLegacy.const_set(:DEPTH, [0])
+    module MkxpLegacy
+      def self.swap(to_real)
+        v = $VERBOSE
+        $VERBOSE = nil
+        NAMES.each do |n|
+          val = to_real ? Object.const_get("#{n}_REAL") : STATS[:spoof][n]
+          Object.send(:remove_const, n)
+          Object.const_set(n, val)
+        end
+      ensure
+        $VERBOSE = v
+      end
+    end
+    MkxpLegacy::STATS[:spoof] = {}
+    names.each { |n| MkxpLegacy::STATS[:spoof][n] = Object.const_get(n) }
+    module Kernel
+      alias_method :__mkxp_legacy_require, :require
+      def require(name)
+        depth = MkxpLegacy::DEPTH
+        if depth[0] == 0
+          depth[0] = 1
+          begin
+            MkxpLegacy.swap(true)
+            return __mkxp_legacy_require(name)
+          ensure
+            MkxpLegacy.swap(false)
+            depth[0] = 0
+          end
+        end
+        __mkxp_legacy_require(name)
+      end
+      module_function :require
+    end
+  end
+end
diff -ruN '--exclude=.git' orig/proj/app/jni/ruby-legacy/mkxp_legacy.inc AnyPlay-Plugin-RGSS-main/AnyPlay-Plugin-RGSS-main/app/jni/ruby-legacy/mkxp_legacy.inc
--- a/app/jni/ruby-legacy/mkxp_legacy.inc	1970-01-01 00:00:00.000000000 +0000
+++ b/app/jni/ruby-legacy/mkxp_legacy.inc	2026-11-07 07:39:35.321894171 +0000
@@ -0,0 +1,180 @@
+/*
+ * mkxp_legacy.inc -- AnyPlay "Ruby 1.8 compatibility" layer for the r18 runtime.
+ *
+ * This file is NOT compiled on its own. apply-legacy-patches.py copies it into the
+ * ruby-r18 source tree and appends `#include "mkxp_legacy.inc"` to vm_eval.c, so it
+ * is built as part of libruby (the r18 one only; r3 never gets it).
+ *
+ * Exported API (names follow what the engine calls, see binding/legacy-ruby.h):
+ *   int  mkxp_legacy_set_enabled(int on)       turn legacy mode on/off, returns old value
+ *   int  mkxp_legacy_enabled_p(void)
+ *   void mkxp_legacy_prepare_next_eval(const char *path)
+ *   void mkxp_legacy_cancel_next_eval(void)
+ *   int  mkxp_legacy_caller_p(void)            is the calling Ruby frame legacy code?
+ *
+ * "Legacy code" = code compiled from a file name registered through
+ * prepare_next_eval(). Child iseqs (methods, blocks) of a script keep the script's
+ * path, so everything defined by a game script stays legacy for its whole life,
+ * while Ruby's own stdlib (other paths) keeps normal Ruby 3.1 behaviour.
+ */
+
+#define MKXP_LEGACY_EXPORT __attribute__((visibility("default")))
+
+#include "mkxp_legacy_prelude.h"   /* generated: mkxp_legacy_prelude_src[] */
+
+static int mkxp_legacy_enabled = 0;
+static int mkxp_legacy_spoofed = 0;
+static int mkxp_legacy_shims_done = 0;
+static __thread int mkxp_legacy_next_eval = 0;
+static st_table *mkxp_legacy_paths = NULL;
+
+/* one-entry cache for mkxp_legacy_caller_p (all callers hold the GVL). The key is a
+ * COPY of the path text, not its address: a freed eval string's address can be reused
+ * by a different file name, so an address comparison could return a stale answer. */
+static char mkxp_legacy_last_file[256];
+static int mkxp_legacy_last_result = 0;
+
+MKXP_LEGACY_EXPORT int
+mkxp_legacy_enabled_p(void)
+{
+    return mkxp_legacy_enabled;
+}
+
+MKXP_LEGACY_EXPORT void
+mkxp_legacy_prepare_next_eval(const char *path)
+{
+    if (!mkxp_legacy_enabled) return;
+    mkxp_legacy_next_eval = 1;
+    if (!path || !*path) return;
+    if (!mkxp_legacy_paths) mkxp_legacy_paths = st_init_strtable();
+    if (!st_lookup(mkxp_legacy_paths, (st_data_t)path, NULL)) {
+        char *copy = strdup(path);
+        if (copy) st_insert(mkxp_legacy_paths, (st_data_t)copy, (st_data_t)1);
+    }
+    mkxp_legacy_last_file[0] = '\0'; /* drop the cache */
+}
+
+/* Only clears the "next eval" flag. The path stays registered on purpose: a script
+ * that failed half way may already have defined methods that run later. */
+MKXP_LEGACY_EXPORT void
+mkxp_legacy_cancel_next_eval(void)
+{
+    mkxp_legacy_next_eval = 0;
+}
+
+MKXP_LEGACY_EXPORT int
+mkxp_legacy_next_eval_pending_p(void)
+{
+    return mkxp_legacy_next_eval;
+}
+
+MKXP_LEGACY_EXPORT int
+mkxp_legacy_caller_p(void)
+{
+    const char *file;
+    if (!mkxp_legacy_enabled || !mkxp_legacy_paths) return 0;
+    file = rb_sourcefile();
+    if (!file) return 0;
+    if (mkxp_legacy_last_file[0] && strcmp(file, mkxp_legacy_last_file) == 0)
+        return mkxp_legacy_last_result;
+    mkxp_legacy_last_result = st_lookup(mkxp_legacy_paths, (st_data_t)file, NULL) ? 1 : 0;
+    if (strlen(file) < sizeof(mkxp_legacy_last_file)) strcpy(mkxp_legacy_last_file, file);
+    else mkxp_legacy_last_file[0] = '\0';
+    return mkxp_legacy_last_result;
+}
+
+/* ---- String#[] with an Integer index gives the byte NUMBER in Ruby 1.8 ---- */
+
+static ID mkxp_legacy_id_orig_aref;
+
+static VALUE
+mkxp_legacy_str_aref(int argc, VALUE *argv, VALUE str)
+{
+    if (argc == 1 && FIXNUM_P(argv[0]) && mkxp_legacy_caller_p()) {
+        long len = RSTRING_LEN(str);
+        long idx = FIX2LONG(argv[0]);
+        if (idx < 0) idx += len;
+        if (idx < 0 || idx >= len) return Qnil;
+        return INT2FIX((unsigned char)RSTRING_PTR(str)[idx]);
+    }
+    return rb_funcallv(str, mkxp_legacy_id_orig_aref, argc, argv);
+}
+
+/* ---- RUBY_VERSION & co. -------------------------------------------------- */
+
+static VALUE
+mkxp_legacy_const_swap_body(VALUE ary)
+{
+    long i;
+    for (i = 0; i + 1 < RARRAY_LEN(ary); i += 2) {
+        VALUE name = RARRAY_AREF(ary, i);
+        VALUE val = RARRAY_AREF(ary, i + 1);
+        ID id = SYM2ID(name);
+        if (rb_const_defined_at(rb_cObject, id)) {
+            VALUE old = rb_const_get_at(rb_cObject, id);
+            char realname[64];
+            ID realid;
+            snprintf(realname, sizeof(realname), "%s_REAL", rb_id2name(id));
+            realid = rb_intern(realname);
+            if (!rb_const_defined_at(rb_cObject, realid))
+                rb_define_global_const(realname, old);
+            rb_funcall(rb_cObject, rb_intern("remove_const"), 1, name);
+        }
+        rb_define_global_const(rb_id2name(id), val);
+    }
+    return Qnil;
+}
+
+static void
+mkxp_legacy_apply_version_spoof(void)
+{
+    int state = 0;
+    VALUE platform = rb_const_defined_at(rb_cObject, rb_intern("RUBY_PLATFORM"))
+        ? rb_const_get_at(rb_cObject, rb_intern("RUBY_PLATFORM")) : rb_str_new_cstr("unknown");
+    VALUE desc = rb_sprintf("ruby 1.8.7 (2013-06-27 patchlevel 374) [%"PRIsVALUE"]", platform);
+    VALUE ary = rb_ary_new();
+    VALUE old_verbose = ruby_verbose;
+    rb_ary_push(ary, ID2SYM(rb_intern("RUBY_VERSION")));       rb_ary_push(ary, rb_obj_freeze(rb_str_new_cstr("1.8.7")));
+    rb_ary_push(ary, ID2SYM(rb_intern("RUBY_PATCHLEVEL")));    rb_ary_push(ary, INT2FIX(374));
+    rb_ary_push(ary, ID2SYM(rb_intern("RUBY_RELEASE_DATE")));  rb_ary_push(ary, rb_obj_freeze(rb_str_new_cstr("2013-06-27")));
+    rb_ary_push(ary, ID2SYM(rb_intern("RUBY_COPYRIGHT")));     rb_ary_push(ary, rb_obj_freeze(rb_str_new_cstr("ruby - Copyright (C) 1993-2013 Yukihiro Matsumoto")));
+    rb_ary_push(ary, ID2SYM(rb_intern("RUBY_DESCRIPTION")));   rb_ary_push(ary, rb_obj_freeze(desc));
+    ruby_verbose = Qnil;
+    rb_protect(mkxp_legacy_const_swap_body, ary, &state);
+    ruby_verbose = old_verbose;
+    if (state) rb_set_errinfo(Qnil);
+    else mkxp_legacy_spoofed = 1;
+    /* RUBY_API_VERSION / RUBY_ENGINE are deliberately left alone: the load path
+     * (lib/ruby/3.1.0) and the C extensions depend on them. */
+}
+
+static VALUE
+mkxp_legacy_eval_prelude(VALUE unused)
+{
+    (void)unused;
+    return rb_eval_string(mkxp_legacy_prelude_src);
+}
+
+MKXP_LEGACY_EXPORT int
+mkxp_legacy_set_enabled(int on)
+{
+    int old = mkxp_legacy_enabled;
+    mkxp_legacy_enabled = on ? 1 : 0;
+    if (on && !mkxp_legacy_shims_done) {
+        int state = 0;
+        mkxp_legacy_shims_done = 1;
+        mkxp_legacy_id_orig_aref = rb_intern("__mkxp_legacy_aref");
+        rb_define_alias(rb_cString, "__mkxp_legacy_aref", "[]");
+        rb_define_method(rb_cString, "[]", mkxp_legacy_str_aref, -1);
+        rb_define_method(rb_cString, "slice", mkxp_legacy_str_aref, -1);
+        mkxp_legacy_apply_version_spoof();
+        /* prelude: Ruby-level shims. It reports its own failures in
+         * $__mkxp_legacy_errors, so one bad shim cannot stop the others. */
+        rb_protect(mkxp_legacy_eval_prelude, Qnil, &state);
+        if (state) {
+            rb_gv_set("$__mkxp_legacy_errors", rb_str_new_cstr("prelude failed to load"));
+            rb_set_errinfo(Qnil);
+        }
+    }
+    return old;
+}
